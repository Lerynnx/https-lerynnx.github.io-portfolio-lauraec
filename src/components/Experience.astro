---
const EXPERIENCE = [
  {
    date: 'Nov 2025 — Jan 2026',
    title: 'Full Stack Developer',
    company: 'Xeridia',
    location: 'Spain',
    type: 'University Internship',
    description: [
      'Developed a distributed payment flow system using Java 21 and Spring Boot, processing and validating real-time transactions with high availability.',
      'Built the frontend utilizing React, Vite, TypeScript, and Tailwind CSS.',
      'Implemented real-time user communication via WebSockets (STOMP).',
      'Managed CI/CD pipelines with Jenkins and message queuing with RabbitMQ.',
      'Containerized the application using Docker and Docker Compose.',
      'Ensured traceability and visibility with the Elastic Stack (Elastic, Kibana, Logstash, Filebeat).',
      'Managed version control using Git and GitHub.'
    ]
  },
  {
    date: 'Apr 2022 — Jun 2022',
    title: 'Java Spring Boot Developer',
    company: 'Serbatic',
    location: 'Spain',
    type: 'Vocational Training Internship',
    description: [
      'Trained in Spring Boot by developing a full-featured e-commerce platform with multi-role access (employee, customer, admin, guest).',
      'Managed core business operations within the application, including purchases, inventory, invoicing, and payroll.',
      'Developed the frontend using Thymeleaf and Bootstrap, and implemented multithreading for concurrency.',
      'Received training in team management, conflict resolution, and personality typing.'
    ]
  }
];
---

<section class="w-full min-h-screen py-16 px-5 max-w-4xl mx-auto flex flex-col gap-10">
    <div class="flex flex-col gap-3">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white tracking-tight">Experience</h2>
        <div class="w-16 h-1.5 bg-indigo-600 rounded-full"></div>
    </div>

    <ol class="relative border-s-2 border-gray-500 dark:border-gray-600 ml-3 md:ml-4 mt-6">
        {
        EXPERIENCE.map((item) => (
            <li class="mb-14 ms-8">
                {/* Timeline Dot */}
                <span class="absolute flex items-center justify-center w-4 h-4 bg-indigo-100 rounded-full -inset-s-2.25 ring-4 ring-white dark:ring-gray-950 dark:bg-indigo-900">
                    <div class="w-2 h-2 bg-indigo-600 rounded-full dark:bg-indigo-400"></div>
                </span>

                <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-2 gap-2">
                    <h3 class="text-3xl font-bold text-gray-900 dark:text-white tracking-tight">
                        {item.title}
                    </h3>
                    <time class="text-sm font-medium px-3 py-1 bg-indigo-400 dark:bg-gray-800 opacity-75 text-gray-50 dark:text-gray-200 rounded-full w-fit">
                        {item.date}
                    </time>
                </div>

                <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-5 font-semibold text-indigo-50 dark:text-indigo-200">
                    <span class="flex items-center gap-1.5 font-bold bg-indigo-400 dark:bg-indigo-900 px-2 py-1 rounded-full">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                        {item.company}
                    </span>
                    <span class="hidden sm:inline text-gray-600 dark:text-gray-600">•</span>
                    <span class="text-gray-800 dark:text-gray-400">{item.location}</span>
                    <span class="hidden sm:inline text-gray-600 dark:text-gray-600">•</span>
                    <span class="text-gray-800 dark:text-gray-400 italic">{item.type}</span>
                </div>

                <ul class="text-base font-normal text-gray-800 dark:text-gray-200 space-y-2.5 list-disc list-outside ml-4 marker:text-gray-800 dark:marker:text-gray-100">
                    {item.description.map((bullet) => (
                        <li class="leading-relaxed">{bullet}</li>
                    ))}
                </ul>
            </li>
        ))
        }
    </ol>
</section>