---
import logo from '../assets/logo.webp';
---

<header class=" opacity-95 flex justify-between fixed items-center p-4 bg-white shadow-md w-full max-w-4xl mx-auto border-b border-gray-200 rounded-xl mt-3 dark:bg-gray-800 dark:border-gray-700 transition-all duration-300 ease-in-out hover:shadow-lg">
    <div class="flex items-center gap-2">
        <img src={logo.src} alt="Laura logo" class="h-8 transition-transform duration-300 hover:scale-110" />
    </div>
    <div class="hidden md:flex gap-2">
        <nav>
            <ul class="flex gap-2">
                <li><a href="/portfolio-lauraec/" class="dark:text-white px-3 py-2 text-sm font-medium rounded-lg transition-all duration-300 hover:bg-purple-100 dark:hover:bg-purple-900">Home</a></li>
                <li><a href="/portfolio-lauraec/experience" class="dark:text-white px-3 py-2 text-sm font-medium rounded-lg transition-all duration-300 hover:bg-purple-100 dark:hover:bg-purple-900">Experience</a></li>
                <li><a href="/portfolio-lauraec/projects" class="dark:text-white px-3 py-2 text-sm font-medium rounded-lg transition-all duration-300 hover:bg-purple-100 dark:hover:bg-purple-900">Projects</a></li>
                <li><a href="/portfolio-lauraec/education" class="dark:text-white px-3 py-2 text-sm font-medium rounded-lg transition-all duration-300 hover:bg-purple-100 dark:hover:bg-purple-900">Education</a></li>
                <li><a href="/portfolio-lauraec/contact" class="dark:text-white px-3 py-2 text-sm font-medium rounded-lg transition-all duration-300 hover:bg-purple-100 dark:hover:bg-purple-900">Contact</a></li>
            </ul>
        </nav>
    </div>
    <button id="menu-toggle" class="md:hidden p-2 transition-transform duration-300 hover:scale-110">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
    </button>
</header>

<!-- Mobile Menu -->
<div id="mobile-menu" class="md:hidden hidden fixed top-20 left-0 w-full bg-white dark:bg-gray-800 shadow-md p-4 border-t border-gray-200 dark:border-gray-700 opacity-95 z-50 transition-all duration-300 ease-in-out rounded-b-md">
    <nav>
        <ul class="flex flex-col gap-4 justify-center items-center h-full">
            <li><a href="/portfolio-lauraec/" class="dark:text-white px-3 py-2 text-lg font-medium rounded-lg transition-all duration-300 hover:bg-purple-100 dark:hover:bg-purple-900">Home</a></li>
            <li><a href="/portfolio-lauraec/experience" class="dark:text-white px-3 py-2 text-lg font-medium rounded-lg transition-all duration-300 hover:bg-purple-100 dark:hover:bg-purple-900">Experience</a></li>
            <li><a href="/portfolio-lauraec/projects" class="dark:text-white px-3 py-2 text-lg font-medium rounded-lg transition-all duration-300 hover:bg-purple-100 dark:hover:bg-purple-900">Projects</a></li>
            <li><a href="/portfolio-lauraec/education" class="dark:text-white px-3 py-2 text-lg font-medium rounded-lg transition-all duration-300 hover:bg-purple-100 dark:hover:bg-purple-900">Education</a></li>
            <li><a href="/portfolio-lauraec/contact" class="dark:text-white px-3 py-2 text-lg font-medium rounded-lg transition-all duration-300 hover:bg-purple-900 dark:hover:bg-purple-900">Contact</a></li>
        </ul>
    </nav>
</div>

<style>
    a {
        text-decoration: none;
        font-family: 'Quicksand-Variable';
        font-weight: 500;
        padding: 0.5rem 0.75rem;
        border-radius: 9999px;
        transition: color 0.3s ease-in-out, background-color 0.3s ease-in-out;
    }

    a:hover {
        color: #5a16fa;
        background-color: #f3f4f6dc;
    }

    .active {
        transform: rotate(90deg);
    }
</style>

<script>
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');

    toggle?.addEventListener('click', () => {
        toggle?.classList.toggle('active');
        menu?.classList.toggle('hidden');
    });
</script>