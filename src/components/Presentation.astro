---
import HeroImage from '../assets/me.webp';
import Image from 'astro/components/Image.astro';
---

<div>
	<main class="md:mt-0 mt-40">
		<section class="w-full min-h-[calc(100vh-2rem)] mx-auto flex flex-col md:flex-row items-center gap-12 px-5 max-w-7xl">
			<div class="md:w-1/2 mb-8 md:mb-0">
				<div class="flex items-center justify-between gap-4 flex-wrap mb-5">
					<h1 class="text-5xl font-bold">Laura E.C.</h1>
					<span class="inline-flex items-center rounded-md bg-green-400/10 px-2 py-1 font-medium text-green-600 inset-ring inset-ring-green-500/20">Available for hire</span>
				</div>
				<p class="text-lg mb-6">Full-stack developer with 6 months’ experience. I have developed a real-time transaction system and various e-commerce platforms. I am proficient in CI/CD practices and container deployments.</p>
				
				<div class="flex gap-3">
					<a class="inline-flex items-center rounded-md bg-purple-400/10 px-2 py-1 font-medium text-purple-400 inset-ring inset-ring-purple-400/30 hover:bg-purple-400/20" href="https://linkedin.com/in/lauraescuderoc" target="_blank">LinkedIn</a>
					<a class="inline-flex items-center rounded-md bg-purple-400/10 px-2 py-1 font-medium text-purple-400 inset-ring inset-ring-purple-400/30 hover:bg-purple-400/20" href="https://github.com/Lerynnx" target="_blank">GitHub</a>
					<a class="inline-flex items-center rounded-md bg-yellow-500/10 px-2 py-1 font-medium text-yellow-600 inset-ring inset-ring-yellow-600/20 hover:bg-yellow-400/20" href="mailto:lauraecwork@gmail.com">Contact</a>
				</div>
			</div>
			<div class="md:w-1/2">
				<Image src={HeroImage} alt="Hero" loading="eager" class="w-full rounded-lg" />
			</div>
		</section>
	</main>
</div>