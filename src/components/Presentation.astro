---
import HeroImage from '../assets/me.webp';
---

<div id="container">
	<main>
		<section class="w-full mx-auto py-44 flex flex-col md:flex-row items-center gap-12 px-5 max-w-7xl">
			<div class="md:w-1/2 mb-8 md:mb-0">
				<h1 class="text-5xl font-bold">Laura E.C.</h1>
				<p class="text-lg mb-6">Full-stack developer with 6 months’ experience. I have developed a real-time transaction system for various e-commerce platforms. I am proficient in CI/CD practices and container deployments.</p>
			</div>
			<div class="md:w-1/2">
				<img src={HeroImage.src} alt="Hero image" class="w-full rounded-lg">
			</div>
		</section>
	</main>
</div