---
const { item } = Astro.props;

// Define the shape of the item
type ProjectItem = {
  img: string;
  date: string;
  title: string;
  company: string;
  description: string;
  repository: string;
};
---
<li class="flex flex-col gap-4 bg-purple-50 dark:bg-indigo-950 p-4 rounded-lg shadow-md transition-transform duration-300 opacity-95">
  <div class="relative w-full h-64 md:h-48 lg:h-64 rounded-lg overflow-hidden shadow-lg">
    <img src={item.img} alt={item.title} class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black bg-opacity-50 flex items-center justify-center opacity-0 hover:opacity-100 transition-opacity duration-300">
      <a href={item.repository} target="_blank" rel="noopener noreferrer" class="text-white text-lg font-semibold px-4 py-2 bg-indigo-600 rounded hover:bg-indigo-700 transition-colors duration-300">
        View Repository 
      </a>
    </div>
  </div>
  <div class="flex flex-col gap-2">
    <p class="text-sm text-indigo-900 dark:text-gray-400">{item.date}</p>
    <h3 class="text-xl font-bold text-gray-900 dark:text-white">{item.title}</h3>
    <p class="text-gray-800 dark:text-gray-300">{item.description}</p>
  </div>
</li>