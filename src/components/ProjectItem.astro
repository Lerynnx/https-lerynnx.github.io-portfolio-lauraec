---
import Image from 'astro/components/Image.astro';

const { item } = Astro.props;

type ProjectItem = {
  img: any[];
  date: string;
  title: string;
  company: string;
  description: string;
  repository: string;
  technologies: string[];
};

const slideshowId = `slideshow-${Math.random().toString(36).slice(2, 9)}`;
---

<li class="project-card flex flex-col bg-white dark:bg-indigo-950 rounded-xl shadow-md overflow-hidden transition-shadow duration-300 hover:shadow-xl border border-gray-100 dark:border-indigo-900 opacity-90">

  <a
    href={item.repository}
    target="_blank"
    rel="noopener noreferrer"
    class="relative block w-full overflow-hidden group"
    style="height: 220px;"
  >
    <div
      id={slideshowId}
      class="flex h-full transition-transform duration-700 ease-in-out"
      style="width: 100%;"
      data-total={item.img.length}
    >
      {item.img.map((image: any, index: number) => (
        <div class="shrink-0 w-full h-full">
          <Image
            src={image}
            alt={`${item.title} - ${index + 1}`}
            class="w-full h-full object-cover object-center"
            style="display: block;"
          />
        </div>
      ))}
    </div>

    <div class="absolute inset-0  bg-opacity-0 group-hover:bg-opacity-60 transition-all duration-300 flex items-center justify-center">
      <span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 text-white text-sm font-semibold px-4 py-2 bg-indigo-600 rounded-full shadow-lg">
        View Repository →
      </span>
    </div>

    {item.img.length > 1 && (
      <div class="absolute bottom-2 left-0 right-0 flex justify-center gap-1.5 z-10 pointer-events-none">
        {item.img.map((_: any, i: number) => (
          <span
            class="dot w-1.5 h-1.5 rounded-full bg-white transition-opacity duration-300"
            data-slideshow={slideshowId}
            data-index={i}
            style={i === 0 ? "opacity: 1;" : "opacity: 0.4;"}
          />
        ))}
      </div>
    )}
  </a>

  <div class="flex flex-col gap-2 p-5">
    <div class="flex items-center justify-between gap-2">
      <span class="text-xs font-medium text-indigo-700 dark:text-indigo-300 uppercase tracking-wide">{item.company}</span>
      <span class="text-xs text-gray-600 dark:text-gray-300">{item.date}</span>
    </div>
    <h3 class="text-lg font-bold text-gray-900 dark:text-white leading-snug">{item.title}</h3>
    <p class=" text-gray-800 dark:text-gray-100 leading-relaxed">{item.description}</p>
    <div class="flex flex-wrap gap-2 mt-3">
      {item.technologies.map((tech: string) => (
        <span class="text-xs font-medium text-indigo-800 dark:text-indigo-100 bg-indigo-100 dark:bg-indigo-900 px-2 py-1 rounded-full">
          {tech}
        </span>
      ))}
    </div>
  </div>
</li>

<script>
  function initSlideshows() {
    // Find all slideshows by their id pattern
    document.querySelectorAll('[id^="slideshow-"]').forEach((el) => {
      const slideshow = el as HTMLElement;
      const id = slideshow.id;
      const totalAttr = slideshow.getAttribute('data-total');
      const total = totalAttr ? parseInt(totalAttr, 10) : 0;

      if (total <= 1) return;

      // Avoid double-initializing
      if (slideshow.dataset.initialized === 'true') return;
      slideshow.dataset.initialized = 'true';

      let current = 0;

      const dots = document.querySelectorAll<HTMLElement>(`.dot[data-slideshow="${id}"]`);

      function goTo(index: number) {
        current = index;
        // Width of the visible container
        const containerWidth = slideshow.parentElement?.clientWidth ?? slideshow.clientWidth;
        slideshow.style.transform = `translateX(-${current * containerWidth}px)`;

        dots.forEach((dot, i) => {
          dot.style.opacity = i === current ? '1' : '0.4';
        });
      }

      setInterval(() => {
        goTo((current + 1) % total);
      }, 3500);
    });
  }

  // Run on first page load
  document.addEventListener('DOMContentLoaded', initSlideshows);

  // Run after Astro view transitions
  document.addEventListener('astro:page-load', initSlideshows);
</script>