---
import Header from "../components/Header.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/portfolio-lauraec/favicon.ico" />
    <title>Laura Portfolio</title>
  </head>
  <body
  class="min-h-screen flex flex-col items-center dark:bg-gray-900 dark:text-white"
>
  <div class="absolute inset-0 -z-10 min-h-full w-full overflow-hidden">
    <div
      class="absolute inset-0
  bg-[radial-gradient(125%_125%_at_50%_50%,#fff_35%,#a78bfa_70%,#6d28d9_100%)]
  dark:bg-[radial-gradient(125%_125%_at_50%_50%,#000_35%,#1a0844_70%,#6633ee_100%)]"
    >
    </div>

    <div
      class="absolute inset-[-40%] w-[180%] h-[180%] animate-aurora-1"
      style="
        background: radial-gradient(ellipse 80% 60% at 20% 50%, #4b3ebe40 0%, transparent 70%),
                    radial-gradient(ellipse 60% 80% at 80% 20%, #6e4dff40 0%, transparent 70%);
        -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black 40%, transparent 75%);
        mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black 40%, transparent 75%);
      "
    >
    </div>

    <div
      class="absolute inset-[-40%] w-[180%] h-[180%] animate-aurora-2"
      style="
        background: radial-gradient(ellipse 70% 50% at 70% 80%, #8055f740 0%, transparent 60%),
                    radial-gradient(ellipse 50% 70% at 30% 30%, #6366f133 0%, transparent 65%);
        -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black 40%, transparent 75%);
        mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black 40%, transparent 75%);
      "
    >
    </div>

    <div
      class="absolute inset-[-40%] w-[180%] h-[180%] animate-aurora-3"
      style="
        background: radial-gradient(ellipse 90% 40% at 50% 50%, #c084fc30 0%, transparent 55%);
        -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black 40%, transparent 75%);
        mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black 40%, transparent 75%);
      "
    >
    </div>
  </div>

  <Header />
  <div id="presentation">
    <main class="md:mt-0 mt-40">
      <slot />
    </main>
  </div>
  <footer class="w-full text-center text-sm mb-5">Made with ❤️ by LauraEC.</footer>
</body>
</html>

<style>
  @font-face {
    font-family: "Quicksand-Variable";
    src: url("/fonts/Quicksand-VariableFont_wght.ttf") format("truetype");
  }

  :root {
    color-scheme: light dark;
  }

  html,
  body {
    min-height: 100vh;
    margin: 0;
  }

  html {
    font-family: "Quicksand-Variable";
    font-weight: 400;
  }

  body {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    background-color: var(--bg-color);
  }
</style>